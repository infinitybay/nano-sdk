{
  "name": "nano-sdk",
  "version": "1.0.3",
  "description": "SDK for the Nano cryptocurrency with typed and runtime-validated RPC and WebSocket APIs, a built-in WebSocket client, safe amount arithmetic, and cryptographic utilities.",
  "keywords": [
    "blockchain",
    "crypto",
    "cryptocurrency",
    "nano",
    "nano node",
    "nano rpc",
    "nano sdk",
    "nano websocket",
    "nanocurrency",
    "rpc",
    "sdk",
    "typescript",
    "websocket",
    "zod"
  ],
  "homepage": "https://github.com/infinitybay/nano-sdk#readme",
  "bugs": {
    "url": "https://github.com/infinitybay/nano-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infinitybay/nano-sdk.git"
  },
  "license": "MIT",
  "author": "Andreas Lichnovsky",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "config": {
    "nanoRpcUrl": "http://127.0.0.1:7076",
    "nanoWebSocketUrl": "ws://127.0.0.1:7078"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepare": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:integration": "jest --runInBand --verbose --config jest.integration.config.ts --setupFiles=dotenv/config",
    "test:unit": "jest --runInBand --verbose --config jest.unit.config.ts --setupFiles=dotenv/config",
    "prepublishOnly": "npm run lint && npm run test:unit && npm run build",
    "publish:dry": "npm publish --dry-run"
  },
  "dependencies": {
    "blakejs": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5"
  }
}
